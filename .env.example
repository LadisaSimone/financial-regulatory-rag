# Copy to .env and fill in. Never commit .env.
# Use ONE of these, depending on configs (see README "Choosing a provider")
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-... 
# Optional overrides (REGRAG__<SECTION>__<KEY>)
# REGRAG_CONFIG=configs/experiments/local_bge.yaml
# REGRAG__VECTOR_STORE__URL=http://localhost:6333
# REGRAG__RERANKER__ENABLED=true

# Enable POST /ingest on the API (off by default)
# REGRAG_ALLOW_INGEST=1
# Allow debug payloads (retrieved chunk text) in /query responses
# REGRAG_DEBUG=1
